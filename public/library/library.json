    { "id": "waves-back", "src": "library/sea/waves-back.png", "role": "water", "tags": ["sea", "flood", "waves"], "layer": { "depth": 0.6, "drift": { "x": -40 }, "float": { "amplitude": 18, "speed": 0.35 } } },
    { "id": "waves-front", "src": "library/sea/waves-front.png", "role": "fg", "tags": ["sea", "flood", "waves"], "layer": { "depth": 1.3, "drift": { "x": -90 }, "float": { "amplitude": 26, "speed": 0.45 } } },

    { "id": "ark", "src": "library/props/ark.png", "role": "prop", "tags": ["ark"], "layer": { "depth": 0.8, "fit": "width", "width": 900, "anchor": "center", "offset": { "y": 230 }, "float": { "amplitude": 24, "speed": 0.3, "rotate": 4 } } },
