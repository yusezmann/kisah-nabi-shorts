    { "id": "crowd", "src": "library/people/crowd.png", "role": "figure", "tags": ["crowd", "people"], "layer": { "depth": 1.25, "fit": "width", "width": 1300, "anchor": "bottom", "offset": { "y": 40 }, "enter": { "type": "rise", "duration": 1, "delay": 0.4 } } },
    { "id": "animal-pairs", "src": "library/animals/animal-pairs.png", "role": "figure", "tags": ["animals"], "layer": { "depth": 1.2, "fit": "width", "width": 1250, "anchor": "bottom", "offset": { "y": -40 }, "drift": { "x": 45 }, "enter": { "type": "slideRight", "duration": 1 } } },

    { "id": "sfx-chime", "src": "library/sfx/chime.mp3", "role": "sfx", "tags": ["chime", "divine", "hope"] },
