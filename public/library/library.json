    { "id": "clouds", "src": "library/atmo/clouds.png", "role": "atmo", "tags": ["clouds"], "layer": { "depth": 0.15, "drift": { "x": -18 }, "opacity": 0.8 } },

    { "id": "mountains-far", "src": "library/land/mountains-far.png", "role": "far", "tags": ["mountains", "hills", "land"], "layer": { "depth": 0.32, "fit": "cover" } },
    { "id": "mountain-peak", "src": "library/land/mountain-peak.png", "role": "mid", "tags": ["mountain-peak", "mountain"], "layer": { "depth": 0.45 } },
